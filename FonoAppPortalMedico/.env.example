# Plantilla de variables de entorno para DESARROLLO local.
# Copiar este archivo a ".env" (en esta misma carpeta, junto a manage.py) y ajustar si es necesario:
#   cp .env.example .env
#
# IMPORTANTE: SECRET_KEY debe ser IDÉNTICO al SECRET_KEY del proyecto FonoApp
# (carpeta ../FonoApp/.env). Ambos proyectos comparten la misma base de datos y
# los administradores inician sesión únicamente en FonoApp; si las claves no
# coinciden, sus tokens JWT no serán válidos aquí y no podrán aprobar/rechazar
# acreditaciones de profesionales.
SECRET_KEY=django-insecure-)dj+y&$f2+q)elr0c!&k2fo^*^y+l$p*&l+civ#k3)fx959a0%
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Puerto por defecto de 'python manage.py runserver' (para correr en paralelo
# con FonoApp, que usa el 8000 por defecto). Si no defines esta variable ni
# creas este .env, igual arranca en el 8001 (fallback fijo en el comando).
PORT=8001

# Frontend en desarrollo (separar varios orígenes con comas)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Base de datos PostgreSQL (misma instancia que FonoApp, ver docker-compose.yml)
DB_NAME=fonoDevDB
DB_USER=admin
DB_PASSWORD=secret
DB_HOST=localhost
DB_PORT=5432

# JWT (opcional, se puede omitir para usar los valores por defecto: 60 min / 1 día)
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=1

# Tamaño máximo permitido para cada documento de respaldo subido (en MB)
PM_MEDICO_DOCUMENTO_MAX_MB=5
