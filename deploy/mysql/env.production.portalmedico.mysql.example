# Plantilla de variables de entorno de PRODUCCIÓN para FonoAppPortalMedico,
# apuntando a MySQL en cPanel (V2Networks). Ver también
# env.production.fonoapp.mysql.example — ambas apps deben apuntar a la MISMA
# base de datos (comparten la tabla FonoApp_Administracion) y al MISMO
# SECRET_KEY.

# IMPORTANTE: idéntico al SECRET_KEY definido para FonoApp en producción.
SECRET_KEY=reemplazar-por-una-clave-secreta-unica-de-produccion

DEBUG=False
ALLOWED_HOSTS=portal.tudominio.cl
CORS_ALLOWED_ORIGINS=https://tudominio.cl

# --- Base de datos MySQL: MISMA base que usa FonoApp ---
DATABASE_URL=mysql://usuario_cpanel_fonoapp:REEMPLAZAR@localhost:3306/usuario_cpanel_fonoapp
DATABASE_SSL_REQUIRE=False

# Alternativa con variables sueltas (debe apuntar a la misma DB_NAME que FonoApp):
# DB_ENGINE=mysql
# DB_NAME=usuario_cpanel_fonoapp
# DB_USER=usuario_cpanel_fonouser
# DB_PASSWORD=reemplazar
# DB_HOST=localhost
# DB_PORT=3306

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=1

# Tamaño máximo permitido para cada documento de respaldo subido (en MB)
PM_MEDICO_DOCUMENTO_MAX_MB=5
