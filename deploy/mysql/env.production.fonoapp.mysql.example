# Plantilla de variables de entorno de PRODUCCIÓN para FonoApp, apuntando a
# una base de datos MySQL en cPanel (V2Networks). Reemplaza a
# FonoApp/.env.production.example cuando el motor de base de datos pase a
# MySQL. NO se usa automáticamente y NO debe contener valores reales: sirve
# de referencia para cargar estas variables en "Setup Python App" (sección
# "Environment variables" del formulario) o en los secrets del pipeline.

# Generar con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Debe ser IDÉNTICO al SECRET_KEY de FonoAppPortalMedico en producción.
SECRET_KEY=reemplazar-por-una-clave-secreta-unica-de-produccion

DEBUG=False
ALLOWED_HOSTS=api.tudominio.cl
CORS_ALLOWED_ORIGINS=https://tudominio.cl

# --- Base de datos MySQL ---
# En cPanel, "MySQL® Databases" crea el usuario y la base con el prefijo de
# tu cuenta, ej. usuario_cpanel_fonoapp / usuario_cpanel_fonouser. Debes
# asignar el usuario a la base con TODOS los privilegios desde esa misma
# pantalla (cPanel no lo hace solo).
#
# Opción recomendada: una sola URL de conexión (dj-database-url detecta el
# motor MySQL automáticamente por el prefijo "mysql://").
DATABASE_URL=mysql://usuario_cpanel_fonoapp:REEMPLAZAR@localhost:3306/usuario_cpanel_fonoapp
DATABASE_SSL_REQUIRE=False
# (en cPanel, MySQL normalmente corre en localhost dentro del mismo servidor,
# por lo que no suele requerir SSL en la conexión; ajustar si tu proveedor
# expone MySQL en un host separado).

# Alternativa si prefieres variables sueltas en vez de DATABASE_URL (deben
# coincidir con db_engine_snippet.py aplicado a settings.py):
# DB_ENGINE=mysql
# DB_NAME=usuario_cpanel_fonoapp
# DB_USER=usuario_cpanel_fonouser
# DB_PASSWORD=reemplazar
# DB_HOST=localhost
# DB_PORT=3306

RECAPTCHA_SECRET_KEY=reemplazar-con-la-clave-de-recaptcha-de-produccion

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=1
