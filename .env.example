# Plantilla de variables de entorno para DESARROLLO LOCAL, centralizada para los dos
# proyectos Django del repo (FonoApp y FonoAppPortalMedico). Ambos cargan este MISMO
# archivo (ver `load_dotenv(BASE_DIR.parent / '.env')` en cada settings.py) porque
# comparten base de datos y deben compartir el mismo SECRET_KEY (ver JWT más abajo).
#
# Copiar este archivo a ".env" en la raíz del repo (junto a docker-compose.yml) y
# ajustar si es necesario:
#   cp .env.example .env
#
# La configuración de DESPLIEGUE (entorno "develop" en cPanel, producción) es aparte y
# vive por proyecto: FonoApp/.env.develop, FonoAppPortalMedico/.env.develop,
# FonoApp/.env.production.example — no se centraliza porque cada app en cPanel define
# sus propias variables de entorno vía su panel, no leyendo este archivo.

# IMPORTANTE: debe ser una clave secreta única. Generarla con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-)dj+y&$f2+q)elr0c!&k2fo^*^y+l$p*&l+civ#k3)fx959a0%
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend Angular en desarrollo (separar varios orígenes con comas)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Base de datos ---
# Desarrollo local: BDD MySQL "develop" compartida (misma que consultan ambos
# proyectos). Si se define DATABASE_URL, tiene prioridad sobre las variables DB_*
# de abajo. Formato: mysql://usuario:password@host:puerto/nombre
DB_ENGINE=mysql
DATABASE_URL=reemplazar-con-la-url-de-conexion-de-la-bdd-develop
DATABASE_SSL_REQUIRE=False
# Alternativa en variables sueltas (equivalente a la URL de arriba; usar una u otra):
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=3306

# reCAPTCHA (clave de pruebas, la verificación está deshabilitada en el login por ahora;
# solo la usa FonoApp)
RECAPTCHA_SECRET_KEY=6LfRpCUtAAAAACCBt7qHtR_2WYPGjM3mcoQUwrku

# JWT (opcional, valores por defecto ya usados por ambos proyectos)
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=1

# Tamaño máximo permitido para cada documento de respaldo subido en el Portal Médico (en MB)
PM_MEDICO_DOCUMENTO_MAX_MB=5

# Nota sobre puertos: FonoApp corre por defecto en el 8000 y FonoAppPortalMedico en el
# 8001 (fallback fijo en cada manage.py runserver, no depende de variables de entorno)
# para poder levantar ambos en simultáneo. Sobrescribir puntualmente con, por ejemplo:
#   python manage.py runserver 9000

# --- Cloudinary (almacenamiento de imagenes, documentos y videos) ---
# Credenciales del panel de Cloudinary (Dashboard -> API Keys). Compartidas por
# FonoApp y FonoAppPortalMedico, igual que el resto de este archivo.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
