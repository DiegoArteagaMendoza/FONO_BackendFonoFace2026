# Plantilla de variables de entorno para DESPLIEGUE (producción).
#
# El despliegue de FonoApp todavía no existe: este archivo es un punto de partida para cuando
# se defina el proveedor de hosting. NO se usa automáticamente; sirve como referencia de qué
# variables debe exportar ese entorno (panel del proveedor, secretos de CI/CD, etc.), no como
# un ".env" real a copiar. Ningún valor real (contraseñas, claves) debe vivir en este archivo.

# Generar una clave nueva y secreta exclusiva para producción, por ejemplo:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=reemplazar-por-una-clave-secreta-unica-de-produccion

DEBUG=False

# Dominios reales desde los que se sirve la API (separados por comas), ej: api.fonoapp.cl
ALLOWED_HOSTS=reemplazar-con-el-o-los-dominios-de-produccion

# Dominio(s) real(es) del frontend en producción (separados por comas)
CORS_ALLOWED_ORIGINS=reemplazar-con-el-dominio-del-frontend-en-produccion

# Base de datos: en despliegue se recomienda usar una única URL (formato 12-factor) en vez de
# las variables DB_* sueltas. Si DATABASE_URL está definida, tiene prioridad sobre DB_*.
# Formato: postgres://usuario:password@host:puerto/nombre_bd
DATABASE_URL=reemplazar-con-la-url-de-conexion-de-la-base-de-datos-de-produccion
DATABASE_SSL_REQUIRE=True

# reCAPTCHA de producción (clave distinta a la usada en desarrollo)
RECAPTCHA_SECRET_KEY=reemplazar-con-la-clave-de-recaptcha-de-produccion

# JWT (opcional, ajustar según la política de seguridad definida para producción)
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=1
