# Plantilla de variables de entorno para DESARROLLO local.
# Copiar este archivo a ".env" (en esta misma carpeta, junto a manage.py) y ajustar si es necesario:
#   cp .env.example .env
#
# Los valores de ejemplo ya coinciden con docker-compose.yml, por lo que "tal cual" funcionan
# levantando la base de datos con `docker-compose up -d` desde la raíz del repositorio.

SECRET_KEY=django-insecure-)dj+y&$f2+q)elr0c!&k2fo^*^y+l$p*&l+civ#k3)fx959a0%
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend Angular en desarrollo (separar varios orígenes con comas)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Base de datos PostgreSQL (coincide con docker-compose.yml)
